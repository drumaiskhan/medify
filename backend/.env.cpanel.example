NODE_ENV=production
PORT=3002
DATABASE_URL=postgresql://CPANEL_DB_USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/CPANEL_DB_NAME
DB_SSL=false
DB_POOL_MAX=5
FRONTEND_ORIGINS=https://study.example.com,https://admin.example.com
STUDENT_URL=https://study.example.com
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1
# Same account SSD as your cPanel 50 GB allowance. Never put this inside public_html.
UPLOAD_DIR=/home/CPANEL_USER/medify-storage/books
MAX_BOOK_MB=100
MAIL_MODE=
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASSWORD=
SMTP_FROM=MEDIFY <noreply@example.com>
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email verification is OFF by default: admin approval after payment is the access gate.
# Set true only after SMTP delivery is tested.
REQUIRE_EMAIL_VERIFICATION=false
# Maximum simultaneous devices (sessions) per student account.
MAX_DEVICES=2
# Plan prices in PKR used to compute coupon discounts. Keep equal to student/src/data/plans.ts.
# PLAN_PRICES=quarterly=1000,half-yearly=2000,annual=3500
