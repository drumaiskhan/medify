NODE_ENV=development
MEDIFY_LOCAL_DB=false
PORT=3002
DATABASE_URL=postgresql://CPANEL_DB_USER:PASSWORD@127.0.0.1:5432/CPANEL_DB_NAME
# For Unix-socket-only cPanel PostgreSQL: leave DATABASE_URL blank and set
# PGHOST=/var/run/postgresql
# PGPORT=5432
# PGDATABASE=account_medify
# PGUSER=account_medify
# PGPASSWORD=your_password
DB_SSL=false
DB_POOL_MAX=5
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
STUDENT_URL=http://localhost:3000
COOKIE_SECURE=false
# Set to the verified number of trusted reverse proxy hops, usually 1 behind Passenger.
TRUST_PROXY_HOPS=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MEDIFY <noreply@example.com>
# Used only by npm run admin. Remove password immediately after bootstrapping.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Production: required absolute persistent path OUTSIDE public_html and the backend deployment folder.
# Example: /home/CPANEL_USER/medify-storage/books
# Development only: blank defaults to backend/private-uploads.
UPLOAD_DIR=
MAX_BOOK_MB=100

# Development only: local writes verification/reset emails to .local-data/outbox.
# Production: leave blank and configure SMTP.
MAIL_MODE=

# Email verification is OFF by default: admin approval after payment is the access gate.
# Set true only after SMTP delivery is tested.
REQUIRE_EMAIL_VERIFICATION=false
# Maximum simultaneous devices (sessions) per student account.
MAX_DEVICES=2
# Plan prices in PKR used to compute coupon discounts. Keep equal to student/src/data/plans.ts.
# Leave unset to use the defaults (quarterly 1000, half-yearly 2000, annual 3500).
# PLAN_PRICES=quarterly=1000,half-yearly=2000,annual=3500
